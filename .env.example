# Required — single-user passphrase to access the dashboard.
LIFEOS_PASSWORD=change-me-to-something-long

# Required — random secret used to sign session cookies and encrypt
# integration tokens at rest.
# Generate with:  openssl rand -base64 48
LIFEOS_AUTH_SECRET=replace-with-a-long-random-string

# Public base URL of this deployment. Used to build OAuth callback URLs
# when GOOGLE_OAUTH_REDIRECT_URI / TICKTICK_OAUTH_REDIRECT_URI are not set.
# In dev: http://localhost:3000
LIFEOS_PUBLIC_URL=http://localhost:3000

# --- Google Calendar OAuth ---
# Create an OAuth Client (Web application) in https://console.cloud.google.com/
# Authorized redirect URI: <LIFEOS_PUBLIC_URL>/api/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional override (defaults to <LIFEOS_PUBLIC_URL>/api/oauth/google/callback).
GOOGLE_OAUTH_REDIRECT_URI=

# --- TickTick OAuth ---
# Register at https://developer.ticktick.com/
# Redirect URI: <LIFEOS_PUBLIC_URL>/api/oauth/ticktick/callback
TICKTICK_OAUTH_CLIENT_ID=
TICKTICK_OAUTH_CLIENT_SECRET=
TICKTICK_OAUTH_REDIRECT_URI=

# --- Apple Health (Health Auto Export iOS app) ---
# No OAuth — this dashboard exposes a webhook the iOS app POSTs to. Connect
# Apple Health from Settings to issue an API key. The iOS app needs a
# publicly reachable HTTPS URL (no localhost from your phone), so make sure
# LIFEOS_PUBLIC_URL above points at the deployed URL when wiring it up.
# Health rollups are stored at <LIFEOS_DATA_DIR>/health-samples.json (or
# /tmp/lifeos on Vercel — ephemeral, set LIFEOS_DATA_DIR to persist).
